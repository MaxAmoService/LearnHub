rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════╗
    // ║  DSGVO-konforme Security Rules                              ║
    // ╚══════════════════════════════════════════════════════════════╝

    // User-Profil: eigener User kann alles lesen/schreiben.
    // Fremde Profile sind für Clients komplett gesperrt — Bestenliste und
    // öffentliches Minimal-Profil laufen über Route Handler mit dem Admin
    // SDK (/api/v1/leaderboard, /api/v1/users/[uid]/public).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Lehrpläne: Pläne und Activity-Monats-Docs gehören dem User.
      // Delete braucht eine eigene Klausel: request.resource existiert bei
      // delete nicht, die write-Klausel verweigert Löschen daher implizit.
      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /activity/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Tagesquiz: ein Doc pro Tag (gezogener Fragenbogen + Ergebnis des
      // ersten Durchgangs). Gehört dem User.
      match /quizDays/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Lehrplan-Items: eigene Regel auf Gruppenebene. Verschachtelte
    // match-Blöcke greifen für Collection-Group-Queries NICHT — deshalb hier
    // der rekursive Pfad. uid ist im Item denormalisiert und wird beim
    // Schreiben erzwungen. Delete braucht eine eigene Klausel:
    // request.resource existiert bei delete nicht, die write-Klausel
    // verweigert Löschen daher implizit.
    match /{path=**}/planItems/{itemId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Lehrplan-Vorlagen: öffentlich lesbar, clientseitig nicht schreibbar
    // (nur Admin SDK / Console).
    match /planTemplates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // Username-Reservierungen
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // API-Keys: für Clients KOMPLETT gesperrt (read UND write false).
    // Zugriff ausschließlich über das Firebase Admin SDK in Route Handlern
    // (app/api/v1/...). Hier liegen nur SHA-256-Hashes, nie Klartext-Keys.
    // Eine Aufweichung dieser Regel würde Fremden Zugriff auf fremde UIDs
    // (und damit fremde Lerndaten) über die API ermöglichen.
    match /apiKeys/{keyHash} {
      allow read, write: if false;
    }

    // Feedback: authentifizierte & anonyme Nutzer dürfen erstellen.
    // Löschen nur durch den User, dessen uid im Dokument steht — bei
    // anonymem Feedback ("anonymous") kann kein Client löschen, nur das
    // Admin SDK. Art. 5 Abs. 1 lit. f DSGVO (Integrität fremder Daten).
    match /feedback/{docId} {
      allow read: if false;
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Alles andere: blockiert
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
